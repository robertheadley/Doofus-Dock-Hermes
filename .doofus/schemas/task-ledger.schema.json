{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doofus.local/schemas/hermes-task-ledger-v1.json",
  "title": "Hermes Native Hierarchical Task Ledger",
  "type": "object",
  "required": ["schema_version", "revision", "updated_at", "tasks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task_id", "parent_task_id", "agent_identity", "title", "objective", "state", "owner", "lease_id", "dependencies", "inputs", "outputs", "verification_evidence", "progress", "estimated_remaining_effort", "size_units", "started_at", "last_updated_at"], "properties": {"task_id": {"type": "string", "minLength": 1}, "state": {"type": "string", "enum": ["planned", "in_progress", "implemented", "tested", "verified", "accepted", "blocked", "failed", "unknown"]}, "dependencies": {"type": "array", "items": {"type": "string"}}, "children": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
