{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doofus.local/schemas/hermes-handoff-v1.json",
  "title": "Hermes Native Task Handoff",
  "type": "object",
  "required": ["schema_version", "revision", "state_revision", "project_id", "repository", "task_id", "parent_task_id", "scope_task_id", "task_description", "approved_plan_revision", "authorization", "phase", "checkpoint", "completed_subtasks", "remaining_subtasks", "changed_files", "tests_executed", "known_failures", "blockers", "unresolved_questions", "pending_user_approvals", "active_processes", "external_operations", "last_operation", "uncertain_operations", "recommended_next_action", "previous_agent", "current_owner", "intended_recipient", "task_ledger_revision", "last_event_id", "phase_effort_samples", "legacy_checklist_measurement"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "state_revision": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repository": {"type": "object", "required": ["repository_identity", "branch", "head_commit", "worktree_id", "changed_files", "change_fingerprint"]},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "scope_task_id": {"type": "string", "minLength": 1},
    "task_description": {"type": "string", "minLength": 1},
    "approved_plan_revision": {"type": ["integer", "null"]},
    "authorization": {"type": "object", "required": ["source", "scope", "status"]},
    "phase": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "object", "required": ["state", "verified_at", "summary", "command", "evidence"], "properties": {"state": {"type": "string", "enum": ["planned", "in_progress", "implemented", "tested", "verified", "blocked", "failed", "unknown"]}, "verified_at": {"type": "string", "minLength": 1}, "summary": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "completed_subtasks": {"type": "array", "items": {"type": "string"}},
    "remaining_subtasks": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "array", "items": {"type": "object", "required": ["path", "status", "owner", "change_type"]}},
    "tests_executed": {"type": "array", "items": {"type": "object", "required": ["command", "result", "timestamp"]}},
    "known_failures": {"type": "array"},
    "blockers": {"type": "array"},
    "unresolved_questions": {"type": "array"},
    "pending_user_approvals": {"type": "array"},
    "active_processes": {"type": "array", "items": {"type": "object", "properties": {"process_id": {"type": "string", "minLength": 1, "maxLength": 128}, "kind": {"type": "string", "minLength": 1, "maxLength": 128}, "provider": {"type": "string", "enum": ["codex", "antigravity", "hermes"]}, "model": {"type": ["string", "null"], "maxLength": 256}, "pid": {"type": ["integer", "null"], "minimum": 1}, "state": {"type": "string", "enum": ["running", "stopped", "unknown"]}, "observed_at": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1, "maxLength": 2048}}}},
    "external_operations": {"type": "array", "items": {"type": "object", "properties": {"operation_id": {"type": "string", "minLength": 1, "maxLength": 128}, "kind": {"type": "string", "minLength": 1, "maxLength": 128}, "owner": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"type": "string", "enum": ["codex", "antigravity", "hermes"]}, "model": {"type": ["string", "null"], "maxLength": 256}}}, "state": {"type": "string", "enum": ["running", "succeeded", "failed", "unknown", "not_running_at_bootstrap"]}, "observed_at": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1, "maxLength": 2048}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "last_operation": {"type": "object", "required": ["request_id", "state", "type"]},
    "uncertain_operations": {"type": "array"},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "previous_agent": {"type": "object"},
    "current_owner": {"type": ["object", "null"], "required": ["provider", "model", "lease_id", "scope_task_id", "lease_expires_at", "ownership_state"], "properties": {"provider": {"type": "string", "enum": ["codex", "antigravity", "hermes"]}, "model": {"type": ["string", "null"]}, "lease_id": {"type": "string", "minLength": 1}, "scope_task_id": {"type": "string", "minLength": 1}, "lease_expires_at": {"type": "string", "minLength": 1}, "ownership_state": {"type": "string", "enum": ["active"]}}},
    "intended_recipient": {"type": ["string", "null"], "enum": ["codex", "antigravity", "hermes", null]},
    "task_ledger_revision": {"type": "integer", "minimum": 1},
    "last_event_id": {"type": "string", "minLength": 1},
    "phase_effort_samples": {"type": "array"},
    "legacy_checklist_measurement": {"type": "object", "required": ["completed", "total", "source", "comparable_to_parity"]}
  },
  "additionalProperties": true
}
